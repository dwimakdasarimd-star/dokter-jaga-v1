# Set these values in your deployment platform's Environment Variables.
# Do not commit real credentials to GitHub.
DOKTER_JAGA_USERNAME=your-username
DOKTER_JAGA_PASSWORD=use-a-long-random-password
DOKTER_JAGA_AUTH_SECRET=use-a-long-random-random-secret-at-least-32-characters

# Builder.io public API key (safe to expose in client-side apps; keep private secrets out of the repo)
NEXT_PUBLIC_BUILDER_API_KEY=your-builder-public-api-key
